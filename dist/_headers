# Cloudflare Pages HTTP Headers
# Updated: 2026-06-17
# 优化版：启用Cloudflare Edge缓存，添加安全头和WebP支持

# WebP MIME类型
/*.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=2592000, s-maxage=2592000
  Vary: Accept-Encoding

# Sitemap
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=3600

/sitemap
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, s-maxage=86400

# AI搜索引擎专用文件 - 长缓存（不常更新）
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, s-maxage=86400

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, s-maxage=86400

/ai-sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=3600

/ai.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, s-maxage=86400

# 静态资源 - 长期缓存
/assets/*
  Cache-Control: public, max-age=31536000, immutable, s-maxage=31536000
  Vary: Accept-Encoding

/images/*
  Cache-Control: public, max-age=2592000, s-maxage=2592000
  Vary: Accept-Encoding

# 首页 - 2小时缓存
/
  Cache-Control: public, max-age=7200, s-maxage=7200

# 博客索引页 - 4小时缓存
/blog/
  Cache-Control: public, max-age=14400, s-maxage=14400

# 文档索引页 - 4小时缓存
/docs/
  Cache-Control: public, max-age=14400, s-maxage=14400

# 博客文章 - 12小时缓存
/blog/*
  Cache-Control: public, max-age=43200, s-maxage=43200

# 文档页面 - 12小时缓存
/docs/*
  Cache-Control: public, max-age=43200, s-maxage=43200

# 全局默认 - 2小时缓存 + 安全头
/*
  Cache-Control: public, max-age=7200, s-maxage=7200
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'
